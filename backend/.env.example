PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Where the live NLEX corridor data comes from (the dashboard/Waze system).
CORRIDOR_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Assistant LLM. Both options below are OpenAI-compatible, so only these three
# values change - no code differences.
# ---------------------------------------------------------------------------

# OPTION A - direct to Alibaba. Cheapest and fewest network hops.
#   Sign up: https://bailian.console.alibabacloud.com  (set region to Singapore)
QWEN_API_KEY=your-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# OPTION B - via OpenRouter, with Zero Data Retention enforced.
#   Use this when prompts must not be retained by anyone. With LLM_ZDR=true,
#   OpenRouter routes ONLY to endpoints carrying a zero-retention policy rather
#   than silently falling back to one that logs. OpenRouter itself does not
#   retain prompts unless you opt in to logging (off by default).
#   Sign up: https://openrouter.ai/keys
#   Also switch it on at https://openrouter.ai/settings/privacy
#
# QWEN_API_KEY=sk-or-v1-your-openrouter-key
# QWEN_BASE_URL=https://openrouter.ai/api/v1
# QWEN_MODEL=qwen/qwen3.8-flash
# LLM_ZDR=true
