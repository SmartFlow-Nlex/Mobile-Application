{
  "name": "smartflow-nlex-monorepo",
  "version": "1.0.0",
  "description": "SmartFlow NLEX - Traffic Management Mobile App with Backend API",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "npm install",
    "frontend": "npm run dev -w frontend",
    "backend": "npm run dev -w backend",
    "dev": "npm run frontend & npm run backend",
    "type-check": "npm run type-check -w frontend && npm run type-check -w backend",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "keywords": [
    "react-native",
    "expo",
    "traffic",
    "navigation",
    "typescript"
  ],
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "^54.0.0",
    "expo-linking": "~8.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1"
  },
  "overrides": {
    "metro": "0.83.3"
  }
}
